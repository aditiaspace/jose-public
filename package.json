{
  "name": "jose-workspace",
  "version": "0.2.0",
  "private": true,
  "description": "A private, local, agent-agnostic job-search workspace",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "bin": {
    "jose": "dist/cli.js"
  },
  "files": [
    "dist",
    "instructions",
    "prompts",
    "skills",
    "examples",
    "templates",
    "README.md",
    "README.id.md",
    "SETUP.md",
    "SETUP.id.md",
    "LICENSE",
    "CHANGELOG.md",
    "INSTALL.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "package:release": "npm run build && npm pack"
  },
  "dependencies": {
    "mammoth": "1.13.0",
    "pdf-lib": "1.17.1",
    "pdf-parse": "2.4.5",
    "playwright": "1.64.1",
    "yaml": "2.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
